+-def chunk_text(text, max_chars=1200, overlap=150):
+-    sentences = text.split('. ')
+-    chunks = []
+-    current_chunk = ""
+-    for sentence in sentences:
+-        if len(current_chunk) + len(sentence) + 1 > max_chars:
+-            chunks.append(current_chunk)
+-            current_chunk = sentence
+-        else:
+-            current_chunk += (". " + sentence) if current_chunk else sentence
+-    if current_chunk:
+-        chunks.append(current_chunk)
+-
+-    # Create overlapping chunks
+-    final_chunks = []
+-    for i in range(len(chunks)):
+-        if i == 0:
+-            final_chunks.append(chunks[i])
+-        else:
+-            overlap_chunk = chunks[i-1][-overlap:] + chunks[i]
+-            final_chunks.append(overlap_chunk)
+-
+-    return final_chunks
++def chunk_text(text: str, max_chars=1200, overlap=150) -> List[dict]:
++    """Greedy, sentence-ish chunking with character overlap and offsets."""
++    t = re.sub(r"\s+", " ", (text or "")).strip()
++    out = []
++    i = 0
++    n = len(t)
++    while i < n:
++        j = min(n, i + max_chars)
++        cut = t.rfind(". ", i, j)
++        if cut == -1 or cut - i < max_chars * 0.5:
++            cut = j
++        else:
++            cut += 1
++        chunk = t[i:cut].strip()
++        if chunk:
++            out.append({"text": chunk, "start": i, "end": cut})
++        i = max(cut - overlap, i + 1)
++    return out
+ 
