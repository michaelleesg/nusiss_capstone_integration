+-def extract_iocs(text):
++def extract_iocs(text: str) -> dict:
+     cves = re.findall(r'CVE-\d{4}-\d{4,7}', text)
+     ips = re.findall(r'\b(?:\d{1,3}\.){3}\d{1,3}\b', text)
+     domains = re.findall(r'\b(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}\b', text)
