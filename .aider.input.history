+-        "eval": {},
+-        "fingerprint": "md5:<hex>",
+-        "acl": ["public"]
+-    }
++def md5_hex(s: str) -> str:
++    return hashlib.md5(s.encode("utf-8"), usedforsecurity=False).hexdigest()
