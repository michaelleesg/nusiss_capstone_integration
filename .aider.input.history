++        "harvested_at": rec.get("harvest_date", {}).get("$date") if isinstance(rec.get("harvest_date"), dict) else rec.get("harvest_date"),
++        "language": rec.get("language"),
++        "ioc": iocs,
++        "entities": rec.get("entities", []),
++        "attacks": {
