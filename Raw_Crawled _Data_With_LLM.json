"title": "ASUS Armoury Crate bug lets attackers get Windows admin privileges",,
"url": "https:\/\/www.bleepingcomputer.com\/news\/security\/asus-armoury-crate-bug-lets-attackers-get-windows-admin-privileges\/",,
"summary": "A high-severity vulnerability in ASUS Armoury Crate software, tracked as CVE-2025-3464, allows threat actors to escalate privileges to SYSTEM level on Windows machines. This bug can be exploited to bypass authorization and affects the AsIO3.sys of the Armoury Crate system management software. The issue stems from the driver verifying callers using a hardcoded SHA-256 hash of AsusCertService.exe and a PID allowlist, instead of proper OS-level access controls. Exploiting this flaw can grant attackers direct access to low-level system functionalities. The vulnerability impacts Armoury Crate versions 5.9.9.0 to 6.1.18.0. While no real-world exploitation has been reported, users are advised to update their software to the latest version to mitigate this threat.",,
"cyber_related": true,,
"threat_actors": [],,
"malware": [],,
"cve_vulns": [,
"CVE-2025-3464",
],,
"affected_products": [,
"Asus Armoury Crate",
],,
"iocs": [],,
"mitre_ttps": [,
"T1068 - Exploitation for Privilege Escalation",
],,
"victims": [],,
"sectors": [],,
"patch_availability": true,,
"affects_singapore": false,,
"affects_asean": false,,
"active_exploitation": false,,
"high_tension_event": false,,
"gics_sector": [],,
"csa_cii_sector": [],,
"possible_motivations": [],,
"recommendations_and_mitigations": [,
"Ensure To Monitor And Review System Logs For Any Signs Of Exploitation Related To The Vulnerability.",,
"Implement Os Level Access Controls Instead Of Relying On Hardcoded Sha-256 Hashes.",,
"Update The Asus Armoury Crate Software To The Latest Version Immediately.",
],,
"references": [,
"https:\/\/www.cve.org\/CVERecord?id=CVE-2025-3464",
],,
"cve_severity": "High",,
"cve_vulns_with_rating": [,
"CVE-2025-3464 (High) (CVSS: 8.4)",
],
